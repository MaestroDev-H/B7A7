# Backend API base URL (must include /api/v1)
API_BASE_URL=http://localhost:5000/api/v1

# Frontend base URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Web3Forms access key for public contact form
NEXT_PUBLIC_WEB3FORMS_KEY=

# Seed demo credentials for instant 1-click login
DEMO_ADMIN_EMAIL=admin@housing.com
DEMO_ADMIN_PASSWORD=Admin@12345

DEMO_OWNER_EMAIL=owner@housing.com
DEMO_OWNER_PASSWORD=Owner@12345

DEMO_TENANT_EMAIL=tenant@housing.com
DEMO_TENANT_PASSWORD=Tenant@12345

# Show Stripe test mode card reminder in development
NEXT_PUBLIC_SHOW_TEST_HINT=true
